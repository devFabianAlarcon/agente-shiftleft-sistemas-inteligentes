        "jsCode": "const asvs = 'https://raw.githubusercontent.com/OWASP/ASVS/v4.0.3/4.0/en/';\nconst api  = 'https://raw.githubusercontent.com/OWASP/API-Security/master/editions/2023/en/';\n\nconst fuentes = [\n  { fuente: 'Threat Modeling Cheat Sheet', url: 'https://raw.githubusercontent.com/OWASP/CheatSheetSeries/master/cheatsheets/Threat_Modeling_Cheat_Sheet.md' },\n  { fuente: 'API Top 10 - API1 BOLA',               url: api + '0xa1-broken-object-level-authorization.md' },\n  { fuente: 'API Top 10 - API2 Autenticacion',      url: api + '0xa2-broken-authentication.md' },\n  { fuente: 'API Top 10 - API3 Propiedades',        url: api + '0xa3-broken-object-property-level-authorization.md' },\n  { fuente: 'ASVS V2 Autenticacion',                url: asvs + '0x11-V2-Authentication.md' },\n  { fuente: 'ASVS V4 Control de acceso',            url: asvs + '0x12-V4-Access-Control.md' },\n  { fuente: 'ASVS V5 Validacion',                   url: asvs + '0x13-V5-Validation-Sanitization-Encoding.md' },\n  { fuente: 'ASVS V6 Criptografia',                 url: asvs + '0x14-V6-Cryptography.md' },\n  { fuente: 'ASVS V7 Errores y logs',               url: asvs + '0x15-V7-Error-Logging.md' },\n];\n\nreturn fuentes.map(f => ({ json: f }));\n"
