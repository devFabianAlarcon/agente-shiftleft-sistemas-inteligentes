        "jsCode": "const pr   = $('Datos del PR').first().json;\nconst diff = $('Diff del PR').first().json.data;\n\nreturn [{\n  json: {\n    numero_pr: pr.number,\n    titulo:    pr.title,\n    historia:  pr.body,          // historia de usuario escrita en el PR\n    rama:      pr.head.ref,\n    url_pr:    pr.html_url,\n    diff:      diff.slice(0, 12000),   // límite para no exceder el contexto del modelo\n  }\n}];\n"
