    {
      "parameters": {
        "jsCode": "// Resume la corrida en un solo elemento: correo en HTML y texto corto para Telegram.\nconst filas  = $('Armar matriz').all().map(i => i.json);\nconst pr     = filas[0];\nconst reales = filas.filter(f => f.id_amenaza);            // descarta la fila \"Sin hallazgos\"\nconst altas  = reales.filter(f => f.prioridad === 'alta');\n\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst filasHtml = reales.map(f => `\n  <tr>\n    <td>${esc(f.id_amenaza)}</td><td>${esc(f.stride)}</td><td>${esc(f.cwe)}</td>\n    <td>${esc(f.descripcion)}</td><td>${esc(f.control)}</td>\n    <td>${esc(f.id_requisito)}<br>${esc(f.criterio_gherkin).replace(/\\n/g, '<br>')}</td>\n    <td>${esc(f.id_prueba)}<br>${esc(f.tipo_prueba)}</td><td>${esc(f.prioridad)}</td>\n  </tr>`).join('');\n\nconst html = `\n  <h3>Revisión de seguridad del PR #${pr.numero_pr}: ${esc(pr.titulo)}</h3>\n  <p><a href=\"${pr.evidencia}\">${pr.evidencia}</a></p>\n  ${reales.length === 0\n    ? '<p>El agente no encontró amenazas en este cambio.</p>'\n    : `<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse;font-size:13px\">\n         <tr><th>Amenaza</th><th>STRIDE</th><th>CWE</th><th>Descripción</th><th>Control</th>\n             <th>Requisito (Gherkin)</th><th>Prueba</th><th>Prioridad</th></tr>\n         ${filasHtml}\n       </table>`}`;\n\nconst telegram =\n  `🚨 <b>PR #${pr.numero_pr}: ${esc(pr.titulo)}</b>\\n` +\n  `${altas.length} hallazgo(s) de prioridad alta:\\n` +\n  altas.map(f => `• ${esc(f.id_amenaza)} — ${esc(f.stride)} (${esc(f.cwe) || 'sin CWE'})`).join('\\n') +\n  `\\n${pr.evidencia}`;\n\nreturn [{ json: {\n  numero_pr: pr.numero_pr,\n  total:     reales.length,\n  altas:     altas.length,\n  asunto:    `[Shift-left] PR #${pr.numero_pr}: ${reales.length} hallazgo(s), ${altas.length} de prioridad alta`,\n  html,\n  telegram,\n} }];\n"
      },
