    {
      "parameters": {
        "jsCode": "// Convierte la respuesta del agente en filas de la matriz de trazabilidad:\n// amenaza -> requisito (criterio Gherkin) -> prueba -> evidencia (enlace al PR).\nconst entrada   = $('Preparar entrada').first().json;\nconst hallazgos = $json.output?.hallazgos ?? [];\nconst pr        = entrada.numero_pr;\n\nconst base = {\n  fecha:     new Date().toISOString(),\n  ejecucion: $execution.id,\n  numero_pr: pr,\n  titulo:    entrada.titulo,\n};\n\n// PR sin amenazas: se deja una fila para que la corrida quede registrada.\nif (hallazgos.length === 0) {\n  return [{ json: { ...base, id_amenaza: '', stride: 'Sin hallazgos', componente: '', descripcion: '',\n    cwe: '', control: '', id_requisito: '', criterio_gherkin: '', id_prueba: '', tipo_prueba: '',\n    prioridad: 'ninguna', evidencia: entrada.url_pr } }];\n}\n\nreturn hallazgos.map((h, i) => {\n  const n = i + 1;\n  // El modelo a veces devuelve \"307\" y a veces \"CWE-307\": se deja siempre \"CWE-307\".\n  const numero = String(h.cwe ?? '').replace(/\\D/g, '');\n  return { json: {\n    ...base,\n    id_amenaza:       `AM-PR${pr}-${n}`,\n    stride:           h.stride,\n    componente:       h.componente,\n    descripcion:      h.descripcion,\n    cwe:              numero ? `CWE-${numero}` : '',\n    control:          h.control,\n    id_requisito:     `REQ-PR${pr}-${n}`,\n    criterio_gherkin: h.criterio_gherkin,\n    id_prueba:        `PRU-PR${pr}-${n}`,\n    tipo_prueba:      h.tipo_prueba,\n    prioridad:        String(h.prioridad ?? '').toLowerCase(),\n    evidencia:        entrada.url_pr,\n  } };\n});\n"
      },
      "type": "n8n-nodes-base.code",
